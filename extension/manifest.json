{
  "manifest_version": 3,
  "name": "CareerPilot Auto-Apply",
  "version": "2.2.0",
  "description": "CareerPilot — Apply smarter. Full dashboard with job matches, application tracker, résumé, profile, and auto-apply across Naukri, Shine, Hirist & LinkedIn.",
  "permissions": ["storage", "activeTab", "scripting", "tabs", "alarms"],
  "host_permissions": [
    "https://www.naukri.com/*",
    "https://www.shine.com/*",
    "https://www.hirist.com/*",
    "https://www.linkedin.com/*",
    "https://www.indeed.com/*",
    "http://localhost:4001/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.naukri.com/*"],
      "js": ["content-naukri.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.shine.com/*"],
      "js": ["content-shine.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.hirist.com/*"],
      "js": ["content-hirist.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.linkedin.com/jobs/*"],
      "js": ["content-linkedin.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "CareerPilot",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
